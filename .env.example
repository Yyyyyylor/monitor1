# ============================================================
# Steam CS2 库存监控器 — 配置文件
# 复制此文件为 .env 并修改下方配置
# ============================================================

# ---- 监控目标 ----
# 通过 Web 界面添加用户，此处留空即可
STEAM_IDS=

# ---- 代理设置 ----
# 代理模式: auto=自动检测 | manual=使用下方URL | hosts=hosts直连 | none=不使用代理
# auto 模式会自动检测: 系统代理 → 环境变量 → hosts劫持 → 常见端口探测
STEAM_PROXY_MODE=auto
# manual 模式时填写（支持 HTTP / SOCKS5）
# 示例: http://127.0.0.1:27015  或  socks5://127.0.0.1:1080
STEAM_PROXY_URL=
# hosts 模式时填写（加速器劫持 DNS 后的本地地址）
STEAM_HOSTS_OVERRIDE=
# 可选：Steam 登录 Cookie，用于访问私密库存
# 从浏览器 F12 → Application → Cookies → steamcommunity.com → steamLoginSecure 复制
STEAM_COOKIE=

# ---- 爬取设置（可选） ----
FETCH_INTERVAL_MINUTES=5
REQUEST_DELAY_SECONDS=1.2
PAGE_SIZE=2000
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
# 并发抓取用户数（Steam 对同 IP 并发敏感，默认 3，需实测调参，范围 1~8）
FETCH_CONCURRENCY=3
# 每用户起始随机抖动上限（秒），打散请求避免对齐 Steam 限流窗口
FETCH_JITTER_SECONDS=1.5

# ---- 通知（可选，默认关闭） ----
USER_NOTIFY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DINGTALK_WEBHOOK_URL=
SERVERCHAN_KEY=

# ---- 管理员告警（可选） ----
ADMIN_NOTIFY_ENABLED=false
ADMIN_WEBHOOK_URL=
ADMIN_WEBHOOK_TYPE=telegram
CONSECUTIVE_FAIL_THRESHOLD=3

# ---- Web 服务 ----
# 默认仅监听本机回环，避免暴露到局域网/公网。
# 如需从其他设备访问（或 Docker 端口映射），改为 0.0.0.0，并建议前置反向代理提供 HTTPS。
HEALTH_SERVER_HOST=127.0.0.1
HEALTH_SERVER_PORT=8080
# 使用 scrypt 校验值而非明文密码。可在受控终端运行：
# python -c "from src.web.app import hash_password_for_storage; import getpass; print(hash_password_for_storage(getpass.getpass()))"
WEB_PASSWORD_HASH=
# 旧版明文变量不再被默认接受；迁移完成后删除，不要设置为真实密码。
WEB_PASSWORD=
# 仅紧急回滚时临时开启，完成迁移后必须保持 false。
WEB_ALLOW_LEGACY_PLAINTEXT_PASSWORD=false
# 管理登录默认必须通过 HTTPS；本机直接访问 http://localhost:8080 时设为 true。
# 公网或局域网部署必须保持 false，并通过 HTTPS 反向代理访问。
WEB_ALLOW_INSECURE_HTTP=true
# 仅在可信反向代理已剥离外部 X-Forwarded-* 头时启用。
WEB_TRUST_PROXY_HEADERS=false
# 导入与抓取资源上限。
WEB_MAX_UPLOAD_BYTES=10485760
WEB_MAX_IMPORT_USERS=100
WEB_MAX_IMPORT_ITEMS_PER_USER=100000
MAX_INVENTORY_PAGES=100
MAX_INVENTORY_ITEMS=250000

# ---- 存储维护 ----
CHANGE_RETENTION_DAYS=7
ARCHIVE_RETENTION_DAYS=90
COMPACT_HOUR=3

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- 数据库（一般不需要改） ----
DATABASE_URL=sqlite+aiosqlite:///./data/monitor.db
